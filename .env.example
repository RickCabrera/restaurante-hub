# =====================================================================
# Restaurante Hub — variables de entorno
# Copia este archivo a apps/api/.env para desarrollo.
# En Railway se capturan en Variables del servicio.
# (O) = obligatoria · (R) = recomendada · (-) = opcional
# =====================================================================

# --- Básico -----------------------------------------------------------
NODE_ENV=production                 # (O) development | production
PORT=3000                           # (-) Railway la define sola
DATABASE_URL=                       # (O) Railway: ${{Postgres.DATABASE_URL}}
REDIS_URL=                          # (R) Railway: ${{Redis.REDIS_URL}} — sin Redis las colas corren en memoria
JWT_SECRET=                         # (O) node scripts/gen-secrets.mjs
APP_URL=https://tu-app.up.railway.app   # (O) URL pública de la app (links en WhatsApp, QR, notificaciones)
API_URL=https://tu-app.up.railway.app   # (O) URL pública de la API (mismo dominio si SERVE_WEB=true)
CORS_ORIGINS=*                      # (-) lista separada por comas si la web vive en otro dominio
DEFAULT_BUSINESS_SLUG=demo          # (O) slug del negocio (pnpm create:owner lo muestra)
SERVE_WEB=true                      # (-) la API sirve la app web (imagen Docker ya lo trae activado)
LOG_LEVEL=info

# --- Alta inicial automática (primer deploy) ---------------------------
# Si están definidas, al arrancar se crea el negocio y la cuenta de la dueña (idempotente).
# Borra BOOTSTRAP_OWNER_PASSWORD después del primer inicio de sesión.
BOOTSTRAP_BUSINESS_NAME=
BOOTSTRAP_BUSINESS_SLUG=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_PHONE=

# --- Notificaciones push (celular de la dueña) ------------------------
VAPID_PUBLIC_KEY=                   # (R) node scripts/gen-vapid.mjs
VAPID_PRIVATE_KEY=                  # (R)
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# --- WhatsApp Cloud API (vacío = modo simulador) -----------------------
WHATSAPP_TOKEN=                     # token permanente (usuario del sistema de Meta)
WHATSAPP_PHONE_NUMBER_ID=           # ID del número en Meta
WHATSAPP_BUSINESS_ACCOUNT_ID=       # ID de la cuenta de WhatsApp Business
WHATSAPP_APP_SECRET=                # secreto de la app (valida la firma del webhook)
WHATSAPP_VERIFY_TOKEN=              # texto libre; el mismo en Meta → Webhook
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=es_MX

# --- Mapas (vacío = OpenStreetMap/Nominatim, gratuito) ----------------
GOOGLE_MAPS_API_KEY=                # (-) Geocoding + Places (llave de servidor)
VITE_GOOGLE_MAPS_API_KEY=           # (-) llave de navegador restringida por dominio (build de la web)

# --- Imágenes (vacío = disco local; en Railway usar bucket) -----------
S3_ENDPOINT=                        # Cloudflare R2: https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=                      # URL pública del bucket (p.ej. https://pub-xxx.r2.dev)
UPLOADS_DIR=./uploads

# --- Respaldos automáticos de la base de datos ------------------------
BACKUP_S3_BUCKET=                   # (R) bucket PRIVADO; usa las credenciales S3_*
BACKUP_RETENTION_DAYS=30

# --- Web (solo en build) ----------------------------------------------
VITE_API_URL=                       # vacío = mismo dominio
VITE_BUSINESS_SLUG=                 # slug para el menú público /pedir
