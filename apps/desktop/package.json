{
  "name": "@rh/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Restaurante Hub - app de escritorio con agente de impresión integrado",
  "author": "Restaurante Hub",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icon": "node scripts/gen-icon.mjs",
    "start": "pnpm build && electron .",
    "dist:win": "pnpm build && node scripts/package.mjs --win",
    "dist:linux": "pnpm build && node scripts/package.mjs --linux"
  },
  "dependencies": {
    "@rh/print-agent": "workspace:*",
    "@rh/printing": "workspace:*",
    "@rh/shared": "workspace:*",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  }
}
