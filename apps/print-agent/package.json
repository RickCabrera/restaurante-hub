{
  "name": "@rh/print-agent",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "rh-print-agent": "dist/cli.js" },
  "scripts": {
    "dev": "ts-node --transpile-only src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@rh/printing": "workspace:*",
    "@rh/shared": "workspace:*",
    "iconv-lite": "^0.6.3",
    "socket.io-client": "^4.8.1"
  },
  "optionalDependencies": { "serialport": "^12.0.0" },
  "devDependencies": { "@types/node": "^22.10.0", "ts-node": "^10.9.2", "typescript": "^5.6.3", "vitest": "^2.1.4" }
}
