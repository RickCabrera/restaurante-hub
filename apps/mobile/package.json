{
  "name": "@rh/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Restaurante Hub - app Android (Capacitor)",
  "scripts": {
    "copy:web": "node scripts/copy-web.mjs",
    "build:web": "pnpm --filter @rh/web build && node scripts/copy-web.mjs",
    "android:add": "cap add android && node scripts/patch-android.mjs",
    "android:patch": "node scripts/patch-android.mjs",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:debug": "pnpm build:web && cap sync android && cd android && ./gradlew assembleDebug",
    "android:apk": "pnpm build:web && cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.1",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@capacitor-community/bluetooth-le": "^6.0.2",
    "@capacitor-community/keep-awake": "^5.0.1",
    "cordova-plugin-bluetooth-serial": "^0.4.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
